,{id:"fullstack-8",label:"Digital menu for a coffee shop",prompt:"Build me a digital menu for a coffee shop with drinks by category, photo, and price.",category:"fullstack"},{id:"fullstack-9",label:"Class scheduler for a yoga studio",prompt:"Build me a weekly class schedule for a yoga studio with one-tap signup.",category:"fullstack"},{id:"fullstack-10",label:"Portfolio and booking site for a tattoo artist",prompt:"Build me a portfolio site for a tattoo artist with a gallery and design request form.",category:"fullstack"},{id:"fullstack-11",label:"Loyalty punch card for a coffee shop",prompt:"Build me a digital punch card where customers earn a free drink every 10 purchases.",category:"fullstack"},{id:"fullstack-12",label:"Wholesale order form for an indie food brand",prompt:"Build me a wholesale order form where retailers browse flavors and submit orders.",category:"fullstack"},{id:"mobile-1",label:"Job tracker for a handyman",prompt:"Build me a job tracker where each job has the customer's address, time, and before/after photos.",category:"mobile"},{id:"mobile-2",label:"Pop-up market checkout for a vendor",prompt:"Build me a checkout app with a product grid where the seller taps to add items to a cart.",category:"mobile"},{id:"mobile-3",label:"Lead capture app for an event booth",prompt:"Build me a lead capture app where a booth worker types in a contact and tags interest.",category:"mobile"},{id:"mobile-4",label:"Booking app for a personal trainer",prompt:"Build me a booking app where clients request session slots and the trainer approves them.",category:"mobile"},{id:"mobile-5",label:"Inventory count app for a small shop owner",prompt:"Build me a stock-count app where the owner taps each product to update its count.",category:"mobile"},{id:"mobile-6",label:"Daily revenue log for a food truck",prompt:"Build me a daily log for a food truck with sales total, location, and a weekly chart.",category:"mobile"},{id:"mobile-7",label:"Site walkthrough app for a contractor",prompt:"Build me a punch-list app where the contractor adds items with a photo and assigned trade.",category:"mobile"},{id:"mobile-8",label:"Shot-list app for a wedding photographer",prompt:"Build me a shot-list app where the photographer ticks off must-have shots as captured.",category:"mobile"},{id:"mobile-9",label:"Mobile estimate sender for a freelance pro",prompt:"Build me an estimate app where a freelancer picks line items and generates a PDF.",category:"mobile"},{id:"mobile-10",label:"Tip pool tracker for a restaurant manager",prompt:"Build me a tip pool tracker that splits the day's tips by each server's hours.",category:"mobile"},{id:"mobile-11",label:"Route app for a delivery driver",prompt:"Build me a route app where the driver adds stops and the app orders them by shortest route.",category:"mobile"},{id:"mobile-12",label:"Mobile signup app for a class instructor",prompt:"Build me a signup app where an instructor posts weekly classes and students claim spots.",category:"mobile"}],vUs=["23945418867","120245442805260106"],_Us=[{slug:"instant-quote-widget",label:"Instant Quote Widget",prompt:"Build me a quote tool I can embed on my website. A homeowner answers 3 quick questions - type of work, rough size, and postcode - and instantly sees a price range. Their name and number go into a simple leads table in an admin panel. Mock login for admin."},{slug:"invoice-sender",label:"Invoice Sender",prompt:"Build me a web app where I can create a simple invoice - client name, list of line items, total - and send it to the client as a PDF. The client sees a clean payment page with a Pay Now button. I can see all invoices and their paid/unpaid status in an admin view. Mock logins for now."},{slug:"lead-review-dashboard",label:"Lead & Review Dashboard",prompt:"Build me a one-page dashboard where I can see all my leads, drag them through stages (New, Quoted, Won, Lost), and when I mark a job as Won it shows a one-click button to copy a Google review request message for that client. Mock login for now."},{slug:"client-job-portal",label:"Client Job Portal",prompt:"Build me a client portal where a homeowner logs in and sees the current status of their job, what stage it's at, and any documents I've shared like quotes or invoices. I update the status and upload docs from an admin panel. Mock logins for client and admin."},{slug:"crew-weekly-scheduler",label:"Crew Weekly Scheduler",prompt:"Build me a weekly job planner where I can create jobs, assign each one to a crew member, and see the whole week on a simple grid. Each crew member has their own login and sees only their jobs for the week. Mock logins for now."},{slug:"contractor-landing-page",label:"Contractor Landing Page",prompt:"Build me a clean one-page contractor website with a hero section and a list of services. Their details go into a leads table I can view in an admin panel. Mock login for admin."},{slug:"job-cost-tracker",label:"Job Cost Tracker",prompt:"Build me a job costing tool where I create a job with a budget, then log materials and labour costs against it as the job runs. I can see each job's spend vs budget at a glance on a simple dashboard. Mock login for now."},{slug:"subcontractor-portal",label:"Subcontractor Portal",prompt:"Build me a portal where I can post jobs for subcontractors, they log in and see what's available, and can indicate they're interested. I see all interested subs per job in my admin view and can assign one. Mock logins for both sides."},{slug:"recurring-maintenance-scheduler",label:"Recurring Maintenance Scheduler",prompt:"Build me a tool to manage recurring maintenance jobs - I add a client and set a repeat schedule (monthly, quarterly, annual), and the app shows me a list of what's due this week and next. I can mark jobs as done and add a short note. Mock login for now."},{slug:"quote-to-invoice-pipeline",label:"Quote-to-Invoice Pipeline",prompt:"Build me a simple pipeline where I create a quote, send it to the client for approval with a one-click accept button, and once accepted it converts into an invoice automatically. I can see all quotes and invoices in a single admin view. Mock logins for now."}],wUs=["fullstack","mobile"].flatMap(t=>_Us.map(e=>({id:`contractor-${t}-${e.slug}`,label:e.label,prompt:e.prompt,category:t})));function AUs(t){const e=t?.trim();return e&&vUs.includes(e)?wUs:CUs}const SUs=["#3FF3C8","#62ECFE","#00FF66","#FF8C66","#9B59B6"],$Ne=3,EUs=5,KNe=[.23,1,.32,1];function jie(t){if(t.length===0)return[];const e=Math.min(t.length,$Ne+Math.floor(Math.random()*(EUs-$Ne+1))),n=[...t];for(let s=n.length-1;s>0;s-=1){const o=Math.floor(Math.random()*(s+1));[n[s],n[o]]=[n[o],n[s]]}return n.slice(0,e)}function qNe(t){return{fullstack:jie(t.filter(e=>e.category==="fullstack")),mobile:jie(t.filter(e=>e.category==="mobile"))}}const kUs={hidden:{opacity:0},visible:{opacity:1,transition:{staggerChildren:.06,delayChildren:.1}},exit:{opacity:0,transition:{staggerChildren:.03,staggerDirection:-1}}},TUs={hidden:{opacity:0,y:8},visible:{opacity:1,y:0,transition:{duration:.4,ease:"easeOut"}},exit:{opacity:0,y:-8,transition:{duration:.3,ease:"easeIn"}}},f4t=m.memo(({onChipClick:t,activeTab:e="fullstack",className:n,campaignId:s})=>{const{t:o}=ae("home"),a=tp(),i=AUs(s),[l,c]=m.useState(()=>qNe(i)),d=m.useRef(i);d.current!==i&&(d.current=i,c(qNe(i)));const u=l[e],[p,f]=m.useState(0),[h,g]=m.useState(0),b=m.useCallback(()=>{ie(on.HOME_PAGE_EVENTS.NEW_HOME_EVENTS.PROMPT_CHIPS_SHUFFLED,{location:"new_home_prompt_chips",active_tab:e}),c(x=>({...x,[e]:jie(i.filter(y=>y.category===e))})),f(x=>x+360),g(x=>x+1)},[e,i]);return r.jsxs("div",{"data-testid":_n.newHomePromptChips.container,className:F("flex flex-col items-center gap-3",n),children:[r.jsxs(Kt.button,{type:"button",onClick:b,whileTap:a?void 0:{scale:.97},transition:{duration:.16,ease:KNe},"aria-label":o("newHomePromptChips.shuffleAriaLabel",{defaultValue:"Shuffle prompt suggestions"}),"data-testid":_n.newHomePromptChips.shuffleButton,className:"gr